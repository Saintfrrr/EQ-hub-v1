--[[
	Hub  |  ONE ModuleScript (EQ Hub + Balenci Hub + Ball System)

	Setup (3 pieces, one source file)
	  1. ReplicatedStorage > ModuleScript named "Hub"      <- paste this whole file in it
	  2. ServerScriptService > Script (regular Script)     <- put this one line in it:
	         require(game.ReplicatedStorage.Hub)
	  3. StarterPlayer > StarterPlayerScripts > LocalScript <- the same one line:
	         require(game.ReplicatedStorage.Hub)

	The module checks where it is running. On the server it runs the Ball System,
	on each player's client it opens the hub. Nothing else to configure.

	Choose the hub skin below: "EQ" (light accent, quick fade-in) or
	"Balenci" (purple accent, splash screen load-in).

	CLIENT (hub)
	  Player   : Walk Speed + Jump Height (type a number or drag the slider)
	  Visuals  : FPS Booster, Low Textures, Low Shaders
	  Settings : watermark, UI opacity, full dragging, keybind menu, custom cursor,
	             notifications, menu key, themes (color pickers + font), UI scale
	  Configs  : create / load / overwrite / delete configs, JSON import and export
	  Window buttons (top left): red = unload, yellow = minimize, green = recenter.
	  Configs last for the current session. To keep one, export it and paste the JSON
	  between the quotes of AUTOLOAD_JSON.

	SERVER (ball system, for your own football game)
	  Make the ball a Part (or Model with a PrimaryPart) named "Football" in Workspace.
	  Optional: a Part named "BallSpawn" (reset position) and a Part named
	  "BallResetButton" (admins click it to reset the ball).
	  Catch  : "Catch" prompt (E) near the ball; the server checks range and cooldown.
	  Throw  : the catcher gets a "Throw" tool; click to throw where they face. A thrown ball
	           curves slightly toward the teammate it was aimed at (PassAssist in CONFIG; the
	           same for every player, steers sideways only).
	  Reset  : ball returns to BallSpawn if it falls out of the world, or when your game
	           fires the BallReset event:
	             game:GetService("ServerStorage"):WaitForChild("BallReset"):Fire()
]]

local RunService = game:GetService("RunService")

local HUB_CHOICE = "EQ" -- "EQ" or "Balenci"

local HUBS = {
	EQ = {
		Name = "EQ Hub",
		Gui = "EQHub",
		Accent = Color3.fromRGB(226, 226, 234),
		Splash = false,
	},
	Balenci = {
		Name = "Balenci Hub",
		Gui = "BalenciHub",
		Accent = Color3.fromRGB(124, 92, 255),
		Splash = true,
	},
}
local HUB = HUBS[HUB_CHOICE] or HUBS.Balenci

----------------------------------------------------------------
-- SERVER: ball system
----------------------------------------------------------------
local function runServer()
	local Players = game:GetService("Players")
	local ServerStorage = game:GetService("ServerStorage")
	local RunService = game:GetService("RunService")

	local CONFIG = {
		BallName = "Football",
		CatchRadius = 10,           -- studs; how close a player must be to catch
		CatchCooldown = 0.75,       -- seconds between catches per player
		ThrowSpeed = 70,            -- studs/second forward
		ThrowLift = 28,             -- studs/second upward
		SpawnPartName = "BallSpawn",
		FallbackSpawn = CFrame.new(0, 10, 0),
		KillHeight = -100,          -- ball resets if it falls below this Y
		ResetButtonName = "BallResetButton",
		Admins = {},                -- extra UserIds allowed to use the reset button
		-- Pass assist: applies to EVERY thrower equally. A thrown ball curves gently (sideways
		-- only) toward the teammate it was aimed at. Set Enabled = false to turn it off.
		PassAssist = {
			Enabled = true,
			ConeAngle = 30,         -- degrees; the target must be this close to the throw direction
			MaxRange = 150,         -- studs
			Strength = 2.0,         -- how quickly the ball steers (higher = stronger)
			Duration = 1.8,         -- seconds the assist lasts after the throw
		},
	}

	local ball = nil
	local prompt = nil
	local holder = nil     -- Player holding the ball
	local holdWeld = nil
	local throwTool = nil
	local lastCatch = {}   -- [player] = os.clock() of last catch

	----------------------------------------------------------------
	-- Helpers
	----------------------------------------------------------------
	local function findBall()
		local found = workspace:FindFirstChild(CONFIG.BallName, true)
		if not found then return nil end
		if found:IsA("BasePart") then return found end
		if found:IsA("Model") then
			return found.PrimaryPart or found:FindFirstChildWhichIsA("BasePart")
		end
		return nil
	end

	local function spawnCFrame()
		local spot = workspace:FindFirstChild(CONFIG.SpawnPartName, true)
		if spot and spot:IsA("BasePart") then
			return spot.CFrame + Vector3.new(0, 3, 0)
		end
		return CONFIG.FallbackSpawn
	end

	local function isAdmin(player)
		return RunService:IsStudio()
			or player.UserId == game.CreatorId
			or table.find(CONFIG.Admins, player.UserId) ~= nil
	end

	----------------------------------------------------------------
	-- Holding / releasing
	----------------------------------------------------------------
	local function release()
		if holdWeld then
			holdWeld:Destroy()
			holdWeld = nil
		end
		if throwTool then
			throwTool:Destroy()
			throwTool = nil
		end
		holder = nil
		if ball then
			ball.CanCollide = true
			pcall(function() ball:SetNetworkOwner(nil) end)
		end
		if prompt then
			task.delay(0.4, function()
				if holder == nil and prompt then
					prompt.Enabled = true
				end
			end)
		end
	end

	-- Gently steers a thrown ball sideways toward the teammate it was aimed at.
	-- Server-side and the same for every player; it never touches height or speed.
	local function startPassAssist(thrower, look)
		local assist = CONFIG.PassAssist
		if not assist.Enabled or not ball then return end

		local origin = ball.Position
		local target, bestScore = nil, nil
		for _, p in ipairs(Players:GetPlayers()) do
			local sameTeam = (thrower.Team == nil) or (p.Team == thrower.Team)
			if p ~= thrower and sameTeam then
				local root = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
				if root then
					local to = root.Position - origin
					local dist = to.Magnitude
					if dist > 5 and dist <= assist.MaxRange then
						local angle = math.deg(math.acos(math.clamp(look:Dot(to.Unit), -1, 1)))
						if angle <= assist.ConeAngle then
							local score = angle + dist * 0.05
							if not bestScore or score < bestScore then
								target, bestScore = root, score
							end
						end
					end
				end
			end
		end
		if not target then return end

		local startedAt = os.clock()
		local conn
		conn = RunService.Heartbeat:Connect(function(dt)
			if not ball or not target.Parent or holder ~= nil
				or os.clock() - startedAt > assist.Duration then
				conn:Disconnect()
				return
			end
			local vel = ball.AssemblyLinearVelocity
			local flatVel = Vector3.new(vel.X, 0, vel.Z)
			local aim = target.Position + target.AssemblyLinearVelocity * 0.3 - ball.Position
			local flatAim = Vector3.new(aim.X, 0, aim.Z)
			if flatVel.Magnitude < 5 or flatAim.Magnitude < 2 then
				conn:Disconnect()
				return
			end
			local blended = flatVel.Unit:Lerp(flatAim.Unit, math.clamp(assist.Strength * dt, 0, 1))
			if blended.Magnitude < 0.01 then return end
			local newFlat = blended.Unit * flatVel.Magnitude
			ball.AssemblyLinearVelocity = Vector3.new(newFlat.X, vel.Y, newFlat.Z)
		end)
	end

	local function throwBall(player)
		if holder ~= player or not ball then return end
		local char = player.Character
		local root = char and char:FindFirstChild("HumanoidRootPart")
		if not root then return end

		local look = root.CFrame.LookVector
		local startCFrame = root.CFrame * CFrame.new(0, 1.5, -3)
		release()
		ball.CFrame = startCFrame
		ball.AssemblyLinearVelocity = look * CONFIG.ThrowSpeed + Vector3.new(0, CONFIG.ThrowLift, 0)
		startPassAssist(player, look)
	end

	local function tryCatch(player)
		if holder or not ball then return end

		local now = os.clock()
		if now - (lastCatch[player] or 0) < CONFIG.CatchCooldown then return end

		local char = player.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		local root = char and char:FindFirstChild("HumanoidRootPart")
		local hand = char and (char:FindFirstChild("RightHand") or char:FindFirstChild("Right Arm"))
		if not (hum and root and hand) or hum.Health <= 0 then return end

		-- server-side range check (small tolerance for latency)
		if (root.Position - ball.Position).Magnitude > CONFIG.CatchRadius + 4 then return end

		lastCatch[player] = now
		ball.AssemblyLinearVelocity = Vector3.zero
		ball.AssemblyAngularVelocity = Vector3.zero
		ball.CanCollide = false
		ball.CFrame = hand.CFrame * CFrame.new(0, -0.5, -0.5)

		holdWeld = Instance.new("WeldConstraint")
		holdWeld.Part0 = hand
		holdWeld.Part1 = ball
		holdWeld.Parent = ball

		holder = player
		prompt.Enabled = false

		-- Throw tool
		throwTool = Instance.new("Tool")
		throwTool.Name = "Throw"
		throwTool.ToolTip = "Click to throw the ball"
		throwTool.RequiresHandle = false
		throwTool.CanBeDropped = false
		throwTool.Activated:Connect(function()
			throwBall(player)
		end)
		throwTool.Parent = player:FindFirstChildOfClass("Backpack") or player
		hum:EquipTool(throwTool)
	end

	----------------------------------------------------------------
	-- Reset / teleport (developer + game logic)
	----------------------------------------------------------------
	local function resetBall(cf)
		if not ball then return end
		release()
		ball.AssemblyLinearVelocity = Vector3.zero
		ball.AssemblyAngularVelocity = Vector3.zero
		ball.CFrame = cf or spawnCFrame()
	end

	-- Other server scripts (kickoff, touchdown, out of bounds...) can reset the ball like this:
	--   local ev = game:GetService("ServerStorage"):WaitForChild("BallReset")
	--   ev:Fire()                          -- back to BallSpawn
	--   ev:Fire(CFrame.new(0, 5, 100))     -- to a specific spot
	local resetEvent = Instance.new("BindableEvent")
	resetEvent.Name = "BallReset"
	resetEvent.Parent = ServerStorage
	resetEvent.Event:Connect(function(cf)
		resetBall(typeof(cf) == "CFrame" and cf or nil)
	end)

	----------------------------------------------------------------
	-- Setup
	----------------------------------------------------------------
	task.spawn(function()
		local waited = 0
		while not findBall() do
			task.wait(0.5)
			waited += 0.5
			if waited == 10 then
				warn("[BallSystem] No part named '" .. CONFIG.BallName .. "' found in Workspace yet.")
			end
		end

		ball = findBall()

		prompt = Instance.new("ProximityPrompt")
		prompt.ActionText = "Catch"
		prompt.ObjectText = CONFIG.BallName
		prompt.HoldDuration = 0
		prompt.MaxActivationDistance = CONFIG.CatchRadius
		prompt.RequiresLineOfSight = false
		prompt.KeyboardKeyCode = Enum.KeyCode.E
		prompt.Parent = ball
		prompt.Triggered:Connect(tryCatch)

		-- admin reset button (optional)
		local button = workspace:FindFirstChild(CONFIG.ResetButtonName, true)
		if button and button:IsA("BasePart") then
			local click = Instance.new("ClickDetector")
			click.MaxActivationDistance = 20
			click.Parent = button
			click.MouseClick:Connect(function(player)
				if isAdmin(player) then
					resetBall()
				end
			end)
		end

		-- out-of-bounds check
		while true do
			task.wait(1)
			if ball and ball.Parent and ball.Position.Y < CONFIG.KillHeight then
				resetBall()
			end
		end
	end)

	----------------------------------------------------------------
	-- Players
	----------------------------------------------------------------
	local function watchPlayer(player)
		player.CharacterAdded:Connect(function(char)
			local hum = char:WaitForChild("Humanoid", 5)
			if hum then
				hum.Died:Connect(function()
					if holder == player then release() end
				end)
			end
		end)
		player.CharacterRemoving:Connect(function()
			if holder == player then release() end
		end)
	end

	Players.PlayerAdded:Connect(watchPlayer)
	for _, p in ipairs(Players:GetPlayers()) do
		watchPlayer(p)
	end

	Players.PlayerRemoving:Connect(function(player)
		lastCatch[player] = nil
		if holder == player then release() end
	end)

end

----------------------------------------------------------------
-- CLIENT: hub
----------------------------------------------------------------
local function runClient()
	local AUTOLOAD_JSON = ""

	local Players = game:GetService("Players")
	local UserInputService = game:GetService("UserInputService")
	local TweenService = game:GetService("TweenService")
	local RunService = game:GetService("RunService")
	local Lighting = game:GetService("Lighting")
	local HttpService = game:GetService("HttpService")

	local player = Players.LocalPlayer
	local playerGui = player:WaitForChild("PlayerGui")

	for _, n in ipairs({ "EQHub", "BalenciHub" }) do
		local old = playerGui:FindFirstChild(n)
		if old then old:Destroy() end
	end

	----------------------------------------------------------------
	-- Config / state
	----------------------------------------------------------------
	local DEFAULTS = { Speed = 16, Jump = 7.2 }
	local LIMITS = {
		Speed = { min = 0, max = 1000 },
		Jump = { min = 0, max = 500 },
		Scale = { min = 0.6, max = 1.5 },
		Opacity = { min = 30, max = 100 },
	}

	local state = {
		SpeedOn = false, Speed = 50,
		JumpOn = false, Jump = 30,
	}

	local binds = {
		Menu = Enum.KeyCode.RightShift,
		Speed = Enum.KeyCode.Z,
		Jump = Enum.KeyCode.C,
	}

	local connections = {}
	local function connect(signal, fn)
		local c = signal:Connect(fn)
		table.insert(connections, c)
		return c
	end

	----------------------------------------------------------------
	-- Theme (editable from Settings) + font
	----------------------------------------------------------------
	local theme = {
		Background = Color3.fromRGB(19, 19, 22),
		Main = Color3.fromRGB(27, 27, 31),
		Accent = HUB.Accent,
		Outline = Color3.fromRGB(44, 44, 50),
		Font = Color3.fromRGB(236, 236, 242),
	}

	local P = {} -- derived palette
	local function computePalette()
		local black = Color3.new(0, 0, 0)
		P.Bg = theme.Background
		P.Side = theme.Background:Lerp(black, 0.18)
		P.Card = theme.Main
		P.Input = theme.Background:Lerp(black, 0.3)
		P.Outline = theme.Outline
		P.Hover = theme.Outline:Lerp(theme.Font, 0.3)
		P.Accent = theme.Accent
		P.Text = theme.Font
		P.Sub = theme.Font:Lerp(theme.Background, 0.45)
		P.Off = theme.Main:Lerp(theme.Font, 0.2)
	end
	computePalette()

	local FONT_NAMES = { "Gotham", "GothamBold", "Code", "SourceSans", "Ubuntu", "Arial", "RobotoMono", "Inconsolata", "Nunito" }
	local fontFace = Enum.Font.Gotham

	local themed = {} -- { inst, prop, key }
	local fontTargets = {}

	local function bind(inst, prop, key)
		inst[prop] = P[key]
		table.insert(themed, { inst, prop, key })
	end

	local function applyTheme()
		computePalette()
		for _, e in ipairs(themed) do
			if e[1].Parent then
				e[1][e[2]] = P[e[3]]
			end
		end
	end

	local function applyFont()
		for _, t in ipairs(fontTargets) do
			if t.Parent then t.Font = fontFace end
		end
	end

	----------------------------------------------------------------
	-- Helpers
	----------------------------------------------------------------
	local function new(class, props, parent)
		local obj = Instance.new(class)
		for k, v in pairs(props or {}) do
			obj[k] = v
		end
		obj.Parent = parent
		return obj
	end

	local function corner(parent, r)
		return new("UICorner", { CornerRadius = UDim.new(0, r or 4) }, parent)
	end

	local function outline(parent)
		local s = new("UIStroke", { Thickness = 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, parent)
		bind(s, "Color", "Outline")
		return s
	end

	local function tween(obj, props, t)
		TweenService:Create(obj, TweenInfo.new(t or 0.18, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), props):Play()
	end

	-- Text object that follows the chosen font and theme color
	local function mkText(class, props, parent, colorKey)
		props = props or {}
		props.Font = fontFace
		props.TextSize = props.TextSize or 13
		if props.BackgroundTransparency == nil and props.BackgroundColor3 == nil then
			props.BackgroundTransparency = 1
		end
		local t = new(class, props, parent)
		table.insert(fontTargets, t)
		if colorKey ~= false then
			bind(t, "TextColor3", colorKey or "Text")
		end
		return t
	end

	local function getHumanoid()
		local c = player.Character
		return c and c:FindFirstChildOfClass("Humanoid")
	end

	local function applyMovement()
		local hum = getHumanoid()
		if not hum then return end
		if state.SpeedOn then hum.WalkSpeed = state.Speed end
		if state.JumpOn then
			hum.UseJumpPower = false
			hum.JumpHeight = state.Jump
		end
	end

	local function restoreSpeed()
		local hum = getHumanoid()
		if hum then hum.WalkSpeed = DEFAULTS.Speed end
	end

	local function restoreJump()
		local hum = getHumanoid()
		if hum then
			hum.UseJumpPower = false
			hum.JumpHeight = DEFAULTS.Jump
		end
	end

	-- WCAG-style contrast ratio between two colors
	local function luminance(c)
		local function f(x)
			return x <= 0.03928 and x / 12.92 or ((x + 0.055) / 1.055) ^ 2.4
		end
		return 0.2126 * f(c.R) + 0.7152 * f(c.G) + 0.0722 * f(c.B)
	end

	local function contrastRatio(a, b)
		local la, lb = luminance(a), luminance(b)
		return (math.max(la, lb) + 0.05) / (math.min(la, lb) + 0.05)
	end

	----------------------------------------------------------------
	-- Graphics categories (every change is remembered and restored on off)
	----------------------------------------------------------------
	local function newStore()
		return setmetatable({}, { __mode = "k" })
	end

	local function makeCategory(applyInstance, applyGlobal, revertGlobal)
		local store = newStore()
		local active, token, conn = false, 0, nil

		local function set(inst, prop, value)
			local ok, orig = pcall(function() return inst[prop] end)
			if not ok then return end
			local rec = store[inst]
			if not rec then
				rec = {}
				store[inst] = rec
			end
			if rec[prop] == nil then rec[prop] = orig end
			pcall(function() inst[prop] = value end)
		end

		local function enable()
			if active then return end
			active, token = true, token + 1
			local myToken = token

			if applyGlobal then applyGlobal(set) end

			conn = workspace.DescendantAdded:Connect(function(inst)
				applyInstance(inst, set)
			end)

			task.spawn(function()
				local all = workspace:GetDescendants()
				for i, inst in ipairs(all) do
					if token ~= myToken then return end
					applyInstance(inst, set)
					if i % 300 == 0 then task.wait() end
				end
			end)
		end

		local function disable()
			if not active then return end
			active, token = false, token + 1
			if conn then
				conn:Disconnect()
				conn = nil
			end
			for inst, rec in pairs(store) do
				for prop, value in pairs(rec) do
					pcall(function() inst[prop] = value end)
				end
			end
			store = newStore()
			if revertGlobal then revertGlobal() end
		end

		return {
			enable = enable,
			disable = disable,
			set = function(on)
				if on then enable() else disable() end
			end,
		}
	end

	local origQuality
	local boost = makeCategory(
		function(inst, set)
			if inst:IsA("ParticleEmitter") or inst:IsA("Trail") or inst:IsA("Beam")
				or inst:IsA("Fire") or inst:IsA("Smoke") or inst:IsA("Sparkles") then
				set(inst, "Enabled", false)
			end
		end,
		function(set)
			pcall(function()
				origQuality = settings().Rendering.QualityLevel
				settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
			end)
			local terrain = workspace:FindFirstChildOfClass("Terrain")
			if terrain then
				set(terrain, "Decoration", false)
				set(terrain, "WaterWaveSize", 0)
				set(terrain, "WaterWaveSpeed", 0)
				set(terrain, "WaterReflectance", 0)
			end
		end,
		function()
			if origQuality then
				pcall(function() settings().Rendering.QualityLevel = origQuality end)
				origQuality = nil
			end
		end
	)

	local tex = makeCategory(function(inst, set)
		if inst:IsA("Terrain") then return end
		if inst:IsA("BasePart") then
			set(inst, "Material", Enum.Material.SmoothPlastic)
			set(inst, "Reflectance", 0)
			if inst:IsA("MeshPart") then
				set(inst, "TextureID", "")
			end
		elseif inst:IsA("Decal") or inst:IsA("Texture") then
			set(inst, "Transparency", 1)
		end
	end)

	local shade = makeCategory(
		function(inst, set)
			if inst:IsA("PostEffect") then
				set(inst, "Enabled", false)
			end
		end,
		function(set)
			set(Lighting, "GlobalShadows", false)
			set(Lighting, "EnvironmentDiffuseScale", 0)
			set(Lighting, "EnvironmentSpecularScale", 0)
			for _, inst in ipairs(Lighting:GetDescendants()) do
				if inst:IsA("PostEffect") then
					set(inst, "Enabled", false)
				end
			end
		end
	)

	----------------------------------------------------------------
	-- GUI root
	----------------------------------------------------------------
	local gui = new("ScreenGui", {
		Name = HUB.Gui,
		ResetOnSpawn = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		IgnoreGuiInset = true,
	}, playerGui)

	local WIDTH, HEIGHT, SIDEBAR, HEADER = 680, 460, 178, 44

	-- CanvasGroup so the whole window can fade together (load-in animation and UI Opacity)
	local main = new("CanvasGroup", {
		Name = "Main",
		Size = UDim2.fromOffset(WIDTH, HEIGHT),
		Position = UDim2.new(0.5, -WIDTH / 2, 0.5, -HEIGHT / 2),
		BorderSizePixel = 0,
		GroupTransparency = 0,
	}, gui)
	bind(main, "BackgroundColor3", "Bg")
	corner(main, 8)
	outline(main)
	local uiScale = new("UIScale", { Scale = 1 }, main)

	-- UI Opacity setting
	local opacityOn, opacityValue = false, 85
	local function groupTarget()
		return opacityOn and (1 - opacityValue / 100) or 0
	end
	local function applyOpacity()
		main.GroupTransparency = groupTarget()
	end

	----------------------------------------------------------------
	-- Notifications (off by default, side selectable)
	----------------------------------------------------------------
	local notifyOn, notifySide = false, "Right"

	local toastHolder = new("Frame", {
		Size = UDim2.new(0, 230, 1, -20),
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -12, 0, 10),
		BackgroundTransparency = 1,
		ZIndex = 50,
	}, gui)
	new("UIListLayout", {
		VerticalAlignment = Enum.VerticalAlignment.Bottom,
		Padding = UDim.new(0, 6),
		SortOrder = Enum.SortOrder.LayoutOrder,
	}, toastHolder)

	local function setToastSide(side)
		notifySide = side
		if side == "Left" then
			toastHolder.AnchorPoint = Vector2.new(0, 0)
			toastHolder.Position = UDim2.new(0, 12, 0, 10)
		else
			toastHolder.AnchorPoint = Vector2.new(1, 0)
			toastHolder.Position = UDim2.new(1, -12, 0, 10)
		end
	end

	local function notify(msg)
		if not notifyOn then return end
		local t = new("TextLabel", {
			Size = UDim2.new(1, 0, 0, 30),
			BackgroundColor3 = P.Card,
			BackgroundTransparency = 1,
			Text = msg,
			Font = fontFace,
			TextSize = 13,
			TextColor3 = P.Text,
			TextTransparency = 1,
			ZIndex = 51,
		}, toastHolder)
		corner(t, 6)
		local s = new("UIStroke", { Color = P.Accent, Thickness = 1, Transparency = 1 }, t)
		tween(t, { BackgroundTransparency = 0, TextTransparency = 0 }, 0.2)
		tween(s, { Transparency = 0 }, 0.2)
