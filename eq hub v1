	local function colorPicker(sec, text, default, callback, key)
		local container = new("Frame", {
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			BackgroundTransparency = 1,
		}, sec.content)
		new("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder }, container)

		local head = new("Frame", {
			Size = UDim2.new(1, 0, 0, 24),
			BackgroundTransparency = 1,
			LayoutOrder = 1,
		}, container)
		mkText("TextLabel", {
			Size = UDim2.new(1, -50, 1, 0),
			Text = text,
			TextXAlignment = Enum.TextXAlignment.Left,
		}, head, "Text")

		local swatch = new("TextButton", {
			Size = UDim2.fromOffset(36, 18),
			Position = UDim2.new(1, -36, 0.5, -9),
			Text = "",
			AutoButtonColor = false,
			BorderSizePixel = 0,
			BackgroundColor3 = default,
		}, head)
		corner(swatch, 5)
		outline(swatch)

		local panel = new("Frame", {
			Size = UDim2.new(1, 0, 0, 144),
			Visible = false,
			BorderSizePixel = 0,
			LayoutOrder = 2,
		}, container)
		bind(panel, "BackgroundColor3", "Input")
		corner(panel, 6)
		outline(panel)

		local h, s, v = default:ToHSV()
		local color = default

		-- saturation / value square
		local sv = new("Frame", {
			Size = UDim2.fromOffset(150, 100),
			Position = UDim2.fromOffset(8, 8),
			BackgroundColor3 = Color3.fromHSV(h, 1, 1),
			BorderSizePixel = 0,
			ClipsDescendants = true,
		}, panel)
		corner(sv, 4)
		local white = new("Frame", { Size = UDim2.new(1, 0, 1, 0), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0 }, sv)
		new("UIGradient", { Transparency = NumberSequence.new(0, 1) }, white)
		local black = new("Frame", { Size = UDim2.new(1, 0, 1, 0), BackgroundColor3 = Color3.new(0, 0, 0), BorderSizePixel = 0 }, sv)
		new("UIGradient", { Rotation = 90, Transparency = NumberSequence.new(1, 0) }, black)
		local svKnob = new("Frame", {
			Size = UDim2.fromOffset(10, 10),
			AnchorPoint = Vector2.new(0.5, 0.5),
			BackgroundTransparency = 1,
			ZIndex = 3,
		}, sv)
		corner(svKnob, 5)
		new("UIStroke", { Color = Color3.new(1, 1, 1), Thickness = 2 }, svKnob)
		local svHit = new("TextButton", { Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, Text = "", ZIndex = 4 }, sv)

		-- hue bar
		local hue = new("Frame", {
			Size = UDim2.fromOffset(18, 100),
			Position = UDim2.fromOffset(166, 8),
			BackgroundColor3 = Color3.new(1, 1, 1),
			BorderSizePixel = 0,
		}, panel)
		corner(hue, 4)
		new("UIGradient", {
			Rotation = 90,
			Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0, Color3.fromHSV(0, 1, 1)),
				ColorSequenceKeypoint.new(1 / 6, Color3.fromHSV(1 / 6, 1, 1)),
				ColorSequenceKeypoint.new(2 / 6, Color3.fromHSV(2 / 6, 1, 1)),
				ColorSequenceKeypoint.new(3 / 6, Color3.fromHSV(3 / 6, 1, 1)),
				ColorSequenceKeypoint.new(4 / 6, Color3.fromHSV(4 / 6, 1, 1)),
				ColorSequenceKeypoint.new(5 / 6, Color3.fromHSV(5 / 6, 1, 1)),
				ColorSequenceKeypoint.new(1, Color3.fromHSV(1, 1, 1)),
			}),
		}, hue)
		local hueKnob = new("Frame", {
			Size = UDim2.new(1, 4, 0, 4),
			AnchorPoint = Vector2.new(0.5, 0.5),
			BackgroundColor3 = Color3.new(1, 1, 1),
			BorderSizePixel = 0,
			ZIndex = 3,
		}, hue)
		new("UIStroke", { Color = Color3.new(0, 0, 0), Thickness = 1 }, hueKnob)
		local hueHit = new("TextButton", { Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, Text = "", ZIndex = 4 }, hue)

		-- hex
		local hex = mkText("TextBox", {
			Size = UDim2.new(1, -16, 0, 22),
			Position = UDim2.fromOffset(8, 114),
			Text = "",
			ClearTextOnFocus = false,
			BackgroundColor3 = P.Card,
			BorderSizePixel = 0,
		}, panel, "Accent")
		bind(hex, "BackgroundColor3", "Card")
		corner(hex, 4)

		local function refresh(fire)
			color = Color3.fromHSV(h, s, v)
			sv.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
			svKnob.Position = UDim2.new(s, 0, 1 - v, 0)
			hueKnob.Position = UDim2.new(0.5, 0, h, 0)
			swatch.BackgroundColor3 = color
			hex.Text = "#" .. color:ToHex()
			if fire then callback(color) end
		end
		refresh(false)
		color = default
		swatch.BackgroundColor3 = default
		hex.Text = "#" .. default:ToHex()

		local dragSV, dragHue = false, false
		local function updateSV(input)
			s = math.clamp((input.Position.X - sv.AbsolutePosition.X) / sv.AbsoluteSize.X, 0, 1)
			v = 1 - math.clamp((input.Position.Y - sv.AbsolutePosition.Y) / sv.AbsoluteSize.Y, 0, 1)
			refresh(true)
		end
		local function updateHue(input)
			h = math.clamp((input.Position.Y - hue.AbsolutePosition.Y) / hue.AbsoluteSize.Y, 0, 0.999)
			refresh(true)
		end
		svHit.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1
				or input.UserInputType == Enum.UserInputType.Touch then
				dragSV = true
				updateSV(input)
			end
		end)
		hueHit.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1
				or input.UserInputType == Enum.UserInputType.Touch then
				dragHue = true
				updateHue(input)
			end
		end)
		connect(UserInputService.InputChanged, function(input)
			if input.UserInputType == Enum.UserInputType.MouseMovement
				or input.UserInputType == Enum.UserInputType.Touch then
				if dragSV then updateSV(input) end
				if dragHue then updateHue(input) end
			end
		end)
		connect(UserInputService.InputEnded, function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1
				or input.UserInputType == Enum.UserInputType.Touch then
				dragSV, dragHue = false, false
			end
		end)

		hex.FocusLost:Connect(function()
			local ok, c = pcall(Color3.fromHex, hex.Text)
			if ok and c then
				h, s, v = c:ToHSV()
				refresh(true)
				color = c
				swatch.BackgroundColor3 = c
				hex.Text = "#" .. c:ToHex()
				callback(c)
			else
				hex.Text = "#" .. color:ToHex()
			end
		end)

		swatch.MouseButton1Click:Connect(function()
			panel.Visible = not panel.Visible
		end)

		local obj = {}
		function obj.get() return color end
		function obj.set(c)
			if typeof(c) ~= "Color3" then return end
			h, s, v = c:ToHSV()
			refresh(true)
			color = c
			swatch.BackgroundColor3 = c
			hex.Text = "#" .. c:ToHex()
			callback(c)
		end

		addEntry(sec, container, text)
		if key then reg(key, obj) end
		return obj
	end

