			Visible = false,
			LayoutOrder = 3,
		}, row)
		new("UIListLayout", { Padding = UDim.new(0, 2), SortOrder = Enum.SortOrder.LayoutOrder }, list)

		local current = default
		local obj = {}

		local function setOptions(opts, keepCurrent)
			options = opts
			for _, c in ipairs(list:GetChildren()) do
				if c:IsA("TextButton") then c:Destroy() end
			end
			if not keepCurrent or not table.find(options, current) then
				current = options[1]
			end
			selectBtn.Text = current or "---"
			for i, opt in ipairs(options) do
				local b = mkText("TextButton", {
					Size = UDim2.new(1, 0, 0, 24),
					Text = opt,
					AutoButtonColor = false,
					BackgroundColor3 = P.Off,
					BackgroundTransparency = 0,
					BorderSizePixel = 0,
					LayoutOrder = i,
				}, list, "Sub")
				bind(b, "BackgroundColor3", "Off")
				corner(b, 4)
				b.MouseButton1Click:Connect(function()
					obj.set(opt)
					list.Visible = false
				end)
			end
		end

		function obj.get() return current end
		function obj.set(v)
			if v ~= nil and table.find(options, v) then
				current = v
				selectBtn.Text = v
				callback(v)
			end
		end
		obj.setOptions = setOptions

		selectBtn.MouseButton1Click:Connect(function()
			list.Visible = not list.Visible
		end)

		setOptions(options, true)
		current = (default and table.find(options, default)) and default or options[1]
		selectBtn.Text = current or "---"

		addEntry(sec, row, text)
		if key then reg(key, obj) end
		return obj
	end

	local function keybind(sec, text, default, callback, key)
		local row = new("Frame", { Size = UDim2.new(1, 0, 0, 24), BackgroundTransparency = 1 }, sec.content)
		mkText("TextLabel", {
			Size = UDim2.new(1, -100, 1, 0),
			Text = text,
			TextXAlignment = Enum.TextXAlignment.Left,
		}, row, "Text")

		local current = default
		local chip = mkText("TextButton", {
			Size = UDim2.fromOffset(92, 22),
			Position = UDim2.new(1, -92, 0.5, -11),
			Text = current and current.Name or "None",
			AutoButtonColor = false,
			BackgroundColor3 = P.Input,
			BorderSizePixel = 0,
			TextSize = 12,
		}, row, "Sub")
		bind(chip, "BackgroundColor3", "Input")
		corner(chip, 6)
		local chipStroke = outline(chip)

		local obj = {}
		local function finish()
			chip.Text = current and current.Name or "None"
			chip.TextColor3 = P.Sub
			tween(chipStroke, { Color = P.Outline })
			listening = nil
		end
		local handleObj = {
			cancel = finish,
			assign = function(k)
				current = k
				callback(k)
				finish()
			end,
		}
		function obj.get() return current end
		function obj.set(k)
			current = k
			callback(k)
			chip.Text = current and current.Name or "None"
		end

		chip.MouseButton1Click:Connect(function()
			if listening == handleObj then
				finish()
				return
			end
			if listening then listening.cancel() end
			listening = handleObj
			chip.Text = "press a key"
			chip.TextColor3 = P.Accent
			tween(chipStroke, { Color = P.Accent })
		end)

		addEntry(sec, row, text)
		if key then reg(key, obj) end
		return obj
	end

