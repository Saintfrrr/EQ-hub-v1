	local function ser(v)
		local t = typeof(v)
		if t == "Color3" then return "#" .. v:ToHex() end
		if t == "EnumItem" then return "Enum:" .. v.Name end
		if v == nil then return "none" end
		return v
	end

	local function deser(v)
		if type(v) == "string" then
			if v:sub(1, 1) == "#" then
				local ok, c = pcall(Color3.fromHex, v)
				return ok and c or nil
			elseif v:sub(1, 5) == "Enum:" then
				return Enum.KeyCode[v:sub(6)]
			elseif v == "none" then
				return nil
			end
		end
		return v
	end

