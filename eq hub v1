	local function toggle(sec, text, default, callback, key)
		local row = new("Frame", { Size = UDim2.new(1, 0, 0, 24), BackgroundTransparency = 1 }, sec.content)
		mkText("TextLabel", {
			Size = UDim2.new(1, -44, 1, 0),
			Text = text,
			TextXAlignment = Enum.TextXAlignment.Left,
		}, row, "Text")

		local track = new("TextButton", {
			Size = UDim2.fromOffset(34, 18),
			Position = UDim2.new(1, -34, 0.5, -9),
			Text = "",
			AutoButtonColor = false,
			BorderSizePixel = 0,
		}, row)
		corner(track, 9)
		local knob = new("Frame", {
			Size = UDim2.fromOffset(14, 14),
			Position = UDim2.fromOffset(2, 2),
			BorderSizePixel = 0,
		}, track)
		corner(knob, 7)

		local on = default == true
		local function render(instant)
			local color = on and P.Accent or P.Off
			local knobColor = on and (luminance(P.Accent) > 0.5 and Color3.fromRGB(24, 24, 28) or Color3.new(1, 1, 1))
				or Color3.fromRGB(196, 196, 204)
			local pos = on and UDim2.fromOffset(18, 2) or UDim2.fromOffset(2, 2)
			if instant then
				track.BackgroundColor3 = color
				knob.BackgroundColor3 = knobColor
				knob.Position = pos
			else
				tween(track, { BackgroundColor3 = color }, 0.2)
				tween(knob, { BackgroundColor3 = knobColor, Position = pos }, 0.2)
			end
		end
		render(true)

		local obj = {}
		function obj.get() return on end
		function obj.set(v, silent)
			on = v == true
			render(false)
			callback(on)
			if not silent then notify(text .. (on and " enabled" or " disabled")) end
		end
		function obj.rerender() render(true) end
		track.MouseButton1Click:Connect(function() obj.set(not on) end)

		table.insert(toggles, obj)
		addEntry(sec, row, text)
		if key then reg(key, obj) end
		return obj
	end

	-- Inline slider: label, thin track with a round knob, typed value on the right.
	local function slider(sec, text, min, max, default, decimals, callback, key)
		local row = new("Frame", { Size = UDim2.new(1, 0, 0, 26), BackgroundTransparency = 1 }, sec.content)
		mkText("TextLabel", {
			Size = UDim2.new(0.3, 0, 1, 0),
			Text = text,
			TextXAlignment = Enum.TextXAlignment.Left,
		}, row, "Sub")

		local track = new("Frame", {
			Size = UDim2.new(0.46, 0, 0, 4),
			Position = UDim2.new(0.32, 0, 0.5, -2),
			BorderSizePixel = 0,
		}, row)
		bind(track, "BackgroundColor3", "Off")
		corner(track, 2)

		local fill = new("Frame", { Size = UDim2.new(0, 0, 1, 0), BorderSizePixel = 0 }, track)
		bind(fill, "BackgroundColor3", "Accent")
		corner(fill, 2)

		local knob = new("Frame", {
			Size = UDim2.fromOffset(12, 12),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0, 0, 0.5, 0),
			BackgroundColor3 = Color3.new(1, 1, 1),
			BorderSizePixel = 0,
			ZIndex = 2,
		}, track)
		corner(knob, 6)

		local hit = new("TextButton", {
			Size = UDim2.new(1, 12, 0, 22),
			Position = UDim2.new(0, -6, 0.5, -11),
			BackgroundTransparency = 1,
			Text = "",
			ZIndex = 3,
		}, track)

		local box = mkText("TextBox", {
			Size = UDim2.new(0.2, 0, 1, 0),
			Position = UDim2.new(0.8, 0, 0, 0),
			Text = tostring(default),
			TextXAlignment = Enum.TextXAlignment.Right,
			ClearTextOnFocus = false,
		}, row, "Accent")

		local mult = 10 ^ decimals
		local value = default

		local function render()
			local a = (value - min) / (max - min)
			fill.Size = UDim2.new(a, 0, 1, 0)
			knob.Position = UDim2.new(a, 0, 0.5, 0)
			box.Text = tostring(value)
		end

		local function setValue(v)
			value = math.clamp(math.floor(v * mult + 0.5) / mult, min, max)
			render()
			callback(value)
		end
		render()

		local dragging = false
		local function fromInput(input)
			local a = math.clamp((input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
			setValue(min + (max - min) * a)
		end
		hit.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1
				or input.UserInputType == Enum.UserInputType.Touch then
				dragging = true
				fromInput(input)
			end
		end)
		connect(UserInputService.InputChanged, function(input)
			if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
				or input.UserInputType == Enum.UserInputType.Touch) then
				fromInput(input)
			end
		end)
		connect(UserInputService.InputEnded, function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1
				or input.UserInputType == Enum.UserInputType.Touch then
				dragging = false
			end
		end)
		box.FocusLost:Connect(function()
			local n = tonumber(box.Text)
			if n then setValue(n) else render() end
		end)

		local obj = {}
		function obj.get() return value end
		function obj.set(v) if type(v) == "number" then setValue(v) end end

		addEntry(sec, row, text)
		if key then reg(key, obj) end
		return obj
	end

	local function dropdown(sec, text, options, default, callback, key)
		local row = new("Frame", {
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			BackgroundTransparency = 1,
		}, sec.content)
