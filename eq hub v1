	local applyConfig
	safe("Configs", function()
		local cfgSec = createSection(pages["Configs"].left, "Configuration")
		local infoSec = createSection(pages["Configs"].right, "Info")

		local configs = {}
		local autoload = nil

		local nameInput = textInput(cfgSec, "Config name", "my config")
		local configDropdown
		local statusLabel = infoLabel(infoSec, "Status: ready")
		local autoloadLabel = infoLabel(infoSec, "Current autoload config: none")
		infoLabel(infoSec, "Configs last for this session. To keep one, export it and paste the JSON into AUTOLOAD_JSON at the top of the script.")

		local function setStatus(text)
			statusLabel.Text = "Status: " .. text
		end

		local function snapshot()
			local cfg = {}
			for _, e in ipairs(registry) do
				cfg[e.key] = ser(e.obj.get())
			end
			return cfg
		end

		applyConfig = function(cfg)
			for _, e in ipairs(registry) do
				local raw = cfg[e.key]
				if raw ~= nil then
					pcall(function() e.obj.set(deser(raw), true) end)
				end
			end
		end

		local function sortedNames()
			local names = {}
			for n in pairs(configs) do table.insert(names, n) end
			table.sort(names)
			return names
		end

		local function refreshConfigList(selectName)
			configDropdown.setOptions(sortedNames(), true)
			if selectName then configDropdown.set(selectName) end
		end

		button(cfgSec, "Create config", function()
			local name = nameInput.get():gsub("^%s+", ""):gsub("%s+$", "")
			if name == "" then
				setStatus("enter a config name")
				return
			end
			configs[name] = snapshot()
			refreshConfigList(name)
			setStatus("created '" .. name .. "'")
		end)

		configDropdown = dropdown(cfgSec, "Config list", {}, nil, function() end)

		button(cfgSec, "Load config", function()
			local name = configDropdown.get()
			if name and configs[name] then
				applyConfig(configs[name])
				setStatus("loaded '" .. name .. "'")
			else
				setStatus("no config selected")
			end
		end)
		button(cfgSec, "Overwrite config", function()
			local name = configDropdown.get()
			if name and configs[name] then
				configs[name] = snapshot()
				setStatus("overwrote '" .. name .. "'")
			else
				setStatus("no config selected")
			end
		end)
		button(cfgSec, "Delete config", function()
			local name = configDropdown.get()
			if name and configs[name] then
				configs[name] = nil
				if autoload == name then
					autoload = nil
					autoloadLabel.Text = "Current autoload config: none"
				end
				refreshConfigList()
				setStatus("deleted '" .. name .. "'")
			else
				setStatus("no config selected")
			end
		end)
		button(cfgSec, "Refresh list", function()
			refreshConfigList()
			setStatus("list refreshed")
		end)
		button(cfgSec, "Set as autoload", function()
			local name = configDropdown.get()
			if name and configs[name] then
				autoload = name
				autoloadLabel.Text = "Current autoload config: " .. name
				setStatus("autoload set (this session)")
			else
				setStatus("no config selected")
			end
		end)
		button(cfgSec, "Reset autoload", function()
			autoload = nil
			autoloadLabel.Text = "Current autoload config: none"
			setStatus("autoload cleared")
		end)

		divider(cfgSec)
		local jsonInput = textInput(cfgSec, "Config JSON", "paste JSON here")
		button(cfgSec, "Import config", function()
			local ok, data = pcall(HttpService.JSONDecode, HttpService, jsonInput.get())
			if ok and type(data) == "table" then
				applyConfig(data)
				setStatus("imported")
			else
				setStatus("invalid JSON")
			end
		end)
		button(cfgSec, "Export current config", function()
			jsonInput.set(HttpService:JSONEncode(snapshot()))
			setStatus("exported (copy it from the box)")
		end)
	end)

	----------------------------------------------------------------
	-- Keybind handling
	----------------------------------------------------------------
	connect(UserInputService.InputBegan, function(input, processed)
		-- Binding mode: next keyboard key becomes the bind
		if listening then
			if input.UserInputType == Enum.UserInputType.Keyboard then
				if input.KeyCode == Enum.KeyCode.Backspace then
					listening.assign(nil)
				elseif input.KeyCode == Enum.KeyCode.Escape then
					listening.cancel()
				else
					listening.assign(input.KeyCode)
				end
			end
			return
		end

		if processed then return end -- ignores keys typed into text boxes
		if input.UserInputType ~= Enum.UserInputType.Keyboard then return end

		local key = input.KeyCode
		if binds.Menu and key == binds.Menu then
			main.Visible = not main.Visible
		elseif binds.Speed and key == binds.Speed then
			if speedToggle then speedToggle.set(not speedToggle.get()) end
		elseif binds.Jump and key == binds.Jump then
			if jumpToggle then jumpToggle.set(not jumpToggle.get()) end
		end
	end)

	----------------------------------------------------------------
	-- Start
	----------------------------------------------------------------
	selectTab("Player")
	applySearch()
	refreshKeybindPanel()

	if AUTOLOAD_JSON ~= "" and applyConfig then
		local ok, data = pcall(HttpService.JSONDecode, HttpService, AUTOLOAD_JSON)
		if ok and type(data) == "table" then
			applyConfig(data)
		end
	end

	if HUB.Splash then
	-- Load-in animation: splash card with a progress bar, then the window scales in
	do
		local targetScale = uiScale.Scale
		uiScale.Scale = targetScale * 0.86
		main.GroupTransparency = 1
		main.Visible = false

		local splash = new("Frame", {
			Size = UDim2.fromScale(1, 1),
			BackgroundColor3 = Color3.new(0, 0, 0),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			ZIndex = 200,
		}, gui)
		local box = new("Frame", {
			Size = UDim2.fromOffset(280, 110),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			BackgroundColor3 = P.Bg,
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			ZIndex = 201,
		}, splash)
		corner(box, 8)
		local boxStroke = new("UIStroke", { Color = P.Outline, Thickness = 1, Transparency = 1 }, box)
		local boxScale = new("UIScale", { Scale = 0.9 }, box)
		local title = new("TextLabel", {
			Size = UDim2.new(1, 0, 0, 40),
			Position = UDim2.fromOffset(0, 14),
			BackgroundTransparency = 1,
			Text = HUB.Name,
			Font = fontFace,
			TextSize = 24,
			TextColor3 = P.Text,
			TextTransparency = 1,
			ZIndex = 202,
		}, box)
		local status = new("TextLabel", {
			Size = UDim2.new(1, 0, 0, 16),
			Position = UDim2.fromOffset(0, 54),
			BackgroundTransparency = 1,
			Text = "starting",
			Font = fontFace,
			TextSize = 12,
			TextColor3 = P.Sub,
			TextTransparency = 1,
			ZIndex = 202,
		}, box)
		local track = new("Frame", {
			Size = UDim2.new(1, -48, 0, 4),
			Position = UDim2.new(0, 24, 1, -24),
			BackgroundColor3 = P.Off,
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			ZIndex = 202,
		}, box)
		corner(track, 2)
		local fill = new("Frame", {
			Size = UDim2.new(0, 0, 1, 0),
			BackgroundColor3 = P.Accent,
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			ZIndex = 203,
		}, track)
		corner(fill, 2)

		task.spawn(function()
			tween(splash, { BackgroundTransparency = 0.45 }, 0.25)
			tween(box, { BackgroundTransparency = 0 }, 0.3)
			tween(boxStroke, { Transparency = 0 }, 0.3)
			TweenService:Create(boxScale, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
			tween(title, { TextTransparency = 0 }, 0.3)
			tween(status, { TextTransparency = 0 }, 0.3)
			tween(track, { BackgroundTransparency = 0 }, 0.3)
			tween(fill, { BackgroundTransparency = 0 }, 0.3)
			task.wait(0.3)

			local steps = { "loading modules", "applying theme", "ready" }
			for i, text in ipairs(steps) do
				status.Text = text
				TweenService:Create(fill, TweenInfo.new(0.35, Enum.EasingStyle.Quad), { Size = UDim2.new(i / #steps, 0, 1, 0) }):Play()
				task.wait(0.35)
			end
			task.wait(0.15)

			-- splash fades out
			tween(box, { BackgroundTransparency = 1 }, 0.25)
			tween(boxStroke, { Transparency = 1 }, 0.25)
			tween(title, { TextTransparency = 1 }, 0.25)
			tween(status, { TextTransparency = 1 }, 0.25)
			tween(track, { BackgroundTransparency = 1 }, 0.25)
			tween(fill, { BackgroundTransparency = 1 }, 0.25)
			tween(splash, { BackgroundTransparency = 1 }, 0.3)
			task.wait(0.2)

			-- window pops in
			main.Visible = true
			tween(main, { GroupTransparency = groupTarget() }, 0.4)
			TweenService:Create(uiScale, TweenInfo.new(0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = targetScale }):Play()
			task.wait(0.4)
			splash:Destroy()
		end)
	end
	else
	-- Load-in animation: quick fade and scale-in
	do
		local targetScale = uiScale.Scale
		uiScale.Scale = targetScale * 0.92
		main.GroupTransparency = 1
		tween(main, { GroupTransparency = groupTarget() }, 0.35)
		TweenService:Create(uiScale, TweenInfo.new(0.45, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = targetScale }):Play()
	end
	end

	----------------------------------------------------------------
	-- Loops
	----------------------------------------------------------------
	local heartbeat = RunService.Heartbeat:Connect(function()
		local hum = getHumanoid()
		if not hum then return end
		if state.SpeedOn and hum.WalkSpeed ~= state.Speed then
			hum.WalkSpeed = state.Speed
		end
		if state.JumpOn then
			if hum.UseJumpPower then hum.UseJumpPower = false end
			if hum.JumpHeight ~= state.Jump then hum.JumpHeight = state.Jump end
		end
	end)

	local acc, frames = 0, 0
	local renderConn = RunService.RenderStepped:Connect(function(dt)
		if cursorDot.Visible then
			local m = UserInputService:GetMouseLocation()
			cursorDot.Position = UDim2.fromOffset(m.X - 5, m.Y - 5)
		end
		if not watermark.Visible then
			acc, frames = 0, 0
			return
		end
		acc += dt
		frames += 1
		if acc >= 0.5 then
			fpsText = ("%d fps"):format(math.floor(frames / acc + 0.5))
			updateWatermark()
			acc, frames = 0, 0
		end
	end)

	-- Unloading puts everything back the way it was
	gui.Destroying:Connect(function()
		heartbeat:Disconnect()
		renderConn:Disconnect()
		for _, c in ipairs(connections) do c:Disconnect() end
		boost.disable()
		tex.disable()
		shade.disable()
		restoreSpeed()
		restoreJump()
		UserInputService.MouseIconEnabled = true
	end)

end

-- Run the half that matches where we are. Any error is printed to the Output window
-- (look for "[Hub]") instead of failing silently.
local ok, err = xpcall(RunService:IsServer() and runServer or runClient, debug.traceback)
if not ok then
	warn("[Hub] " .. (RunService:IsServer() and "server" or "client") .. " part failed:\n" .. tostring(err))
end

return true
