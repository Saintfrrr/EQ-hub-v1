	local function applySearch()
		local q = string.lower(searchBox.Text)
		for _, sec in ipairs(sections) do
			local titleMatch = q == "" or string.find(string.lower(sec.title), q, 1, true) ~= nil
			local any = titleMatch
			for _, e in ipairs(sec.entries) do
				local show = titleMatch or string.find(e.text, q, 1, true) ~= nil
				e.row.Visible = show
				if show then any = true end
			end
			sec.frame.Visible = any
		end
	end
